<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials never leave the device: the encrypted account store, the WebView cookie jar (Google/Spotify
     sessions) and the Keystore-bound blobs are excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="settings.json"/>
        <include domain="file" path="library.json"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="settings.json"/>
        <include domain="file" path="library.json"/>
    </device-transfer>
</data-extraction-rules>
