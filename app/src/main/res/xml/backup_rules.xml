<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: same policy as data_extraction_rules.xml. Only the listed files are backed up;
     secure_accounts.xml, the WebView profile and spotify-device-id are therefore never included. -->
<full-backup-content>
    <include domain="file" path="settings.json"/>
    <include domain="file" path="library.json"/>
</full-backup-content>
