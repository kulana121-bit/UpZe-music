<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 1.0.2: Live radio › Stations near you (approximate only; asked when the user taps Allow). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 1.0.2: Playback › Play when Bluetooth connects. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Normal permission; needed by AudioManager.setPreferredMixerAttributes (bit-perfect USB, Android 14+). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Asked only when the user turns on "Music on this device". -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Asked only when the user taps the microphone in Search (real voice search via SpeechRecognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 1.0.0 in-app updater: hands a downloaded release APK to the system installer (user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:name=".MusicSpotApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="UpZe"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MusicSpot"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.account.SpotifyConnectActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicSpot"
            android:windowSoftInputMode="adjustResize" />
        <!-- v2.0.1 crash safety net: own process, plain views, so it works even when the app cannot start. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:taskAffinity="com.ravi.musicspot.crash"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".playback.BluetoothAutoPlay"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="true"
            android:label="UpZe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <!-- 1.0.0 updater: content:// URI for the downloaded APK (cacheDir/updates only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
